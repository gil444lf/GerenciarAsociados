git init# ---- Base de datos (PostgreSQL) ----
# Local con pgAdmin: postgresql://USUARIO:CLAVE@localhost:5432/gerenciar
# Producción (Neon/Supabase): la cadena de conexión que te da el proveedor
DATABASE_URL="postgresql://usuario:clave@localhost:5432/gerenciar"

# ---- Panel de administrador ----
ADMIN_USER="admin"
ADMIN_PASSWORD="cambia-esta-clave"
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# ---- Chatbot (Groq) ----
GROQ_API_KEY=""

# ---- Correo (formulario de contacto y citas) ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="correo-que-envia@gmail.com"
SMTP_PASS="contraseña-de-aplicacion"
CONTACT_TO_EMAIL="correo-del-cliente@dominio.com"

# ---- Sitio ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# WhatsApp del cliente: formato internacional, sin "+" ni espacios
NEXT_PUBLIC_WHATSAPP_NUMBER="573027065067"
